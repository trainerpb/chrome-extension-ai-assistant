{
    "manifest_version": 3,
    "name": "My Assistant",
    "version": "1.0",
    "description": "An Agentic Extension",
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "idealo.png",
            "48": "idealo.png",
            "128": "idealo.png"
    
  
        },
"default_title": "Open Side Panel"

    },
"side_panel": {
    "default_path": "popup.html"
  },
    "permissions": [
        "scripting",
        "activeTab",
	"sidePanel"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*",
        "file://*/*"
    ]
}